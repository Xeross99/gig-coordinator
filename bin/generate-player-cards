[[12, 3], [52, 2], [94, 4]].each do |(cx, cy)|
  base.rect(cx, cy, 10, 2, "#ffffff")
  base.rect(cx + 2, cy - 1, 6, 1, "#ffffff")
end
base.rect(0, 20, W, 4, "#69a544")           # trawa
base.rect(0, 24, W, 8, "#4d8a2f")           # ziemia
(6..90).step(8) { |x| base.rect(x, 18, 1, 2, "#d9b53f") }  # płotek po lewej

LOADER_YELLOW = "#e8b422"
BOOM_YELLOW   = "#c69a1a"
