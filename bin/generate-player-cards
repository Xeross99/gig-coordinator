astro.rect(153, 8, 1, 1, "#9fd4e8")

cards["kosmos"] = compose(base, [
  [stars_a, blink(dur: "3s")],
  [stars_b, blink(dur: "3s", begin_at: "-1.5s")],
  [rocket,  slide(from: "-16 14", to: "196 -8", dur: "13s")],
  [astro,   %(<animateTransform attributeName="transform" type="translate" values="0 0;0 -2;0 0" dur="3.5s" repeatCount="indefinite"/>)]
])

