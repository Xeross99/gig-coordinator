base.rect(108, 6, 8, 2, "#ffd94d")
base.rect(0, 20, W, 6, "#3f7fbf")           # morze
base.rect(0, 20, W, 1, "#77aede")           # linia horyzontu
base.rect(0, 26, W, 6, "#eede9c")           # plaża
base.rect(180, 12, 2, 14, "#8a5a2b")        # pień palmy
PALM_LEAF_LEGEND = { "L" => "#2f8f4e" }.freeze
palm = Grid.new
palm.stamp([ "LLLL....", ".LLLLL..", "...LLLL." ], PALM_LEAF_LEGEND, 172, 9)
palm.stamp([ "....LLLL", "..LLLLL.", ".LLLL..." ], PALM_LEAF_LEGEND, 182, 9)
palm.stamp([ ".LL.", "LLLL" ], PALM_LEAF_LEGEND, 179, 7)

waves = Grid.new                            # fale suną w prawo (okres 14px → pętla)
(-8..190).step(14) { |x| waves.rect(x, 23, 4, 1, "#77aede") }

beach_chicken = Grid.new                    # kura w okularach buja się
chicken(beach_chicken, 146, 8, scale: 2)
beach_chicken.rect(146, 12, 14, 2, "#111111")
beach_chicken.rect(148, 14, 4, 1, "#111111")
beach_chicken.rect(154, 14, 4, 1, "#111111")

cards["wakacje"] = compose(base, [
  [waves,         slide(from: "0 0", to: "14 0", dur: "4s")],
  [palm,          %(<animateTransform attributeName="transform" type="translate" values="0 0;1 0" keyTimes="0;0.5" calcMode="discrete" dur="2.2s" repeatCount="indefinite"/>)],
  [beach_chicken, bob(dur: "1.2s")]
])

# ── 4. ladowarka — kura na ładowarce teleskopowej ze skrzynią ─────────────────
