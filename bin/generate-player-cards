stars(stars_b, [[18, 12], [44, 3], [70, 27], [94, 20], [126, 26], [154, 27], [64, 2], [178, 4]], color: "#cdd6f4")

ROCKET = [
  "..S.",
  ".SSS",
  ".SRS",
  ".SSS",
  "F.F."
].freeze
