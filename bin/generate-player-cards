# kura wystaje ze skrzyni
machine.rect(113, 4, 6, 3, "#ffffff")
machine.rect(114, 3, 2, 1, "#d53838")       # grzebień
machine.set(117, 5, "#222222")              # oko
# wysięgnik teleskopowy — schodkowa przekątna od skrzyni do tyłu maszyny
7.times { |i| machine.rect(122 + i * 5, 9 + i, 6, 2, BOOM_YELLOW) }
# kabina + korpus
machine.rect(132, 10, 12, 8, LOADER_YELLOW)  # kabina
machine.rect(133, 11, 8, 6, "#cdeefb")       # szyba
machine.rect(134, 17, 28, 6, LOADER_YELLOW) # korpus
machine.rect(154, 14, 8, 3, LOADER_YELLOW)  # przeciwwaga z tyłu
# kura-operator w kabinie
chicken(machine, 133, 9)
# koła
machine.rect(132, 21, 8, 7, "#2b2b2b")
