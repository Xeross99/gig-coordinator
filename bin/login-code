#!/usr/bin/env ruby
# Usage: bin/login-code <email>

require_relative "../config/environment"

email = ARGV[0].to_s.strip.downcase
abort "Użycie: bin/login-code <email>" if email.blank?

record = Host.find_by(email: email) || User.find_by(email: email)
abort "Nie znaleziono rekordu z emailem #{email}" unless record

code = LoginCode.generate_for(record)

puts "#{record.class.name}: #{record.display_name} (#{record.email})"
puts "Kod: #{code.code} (ważny do #{code.expires_at.strftime('%H:%M')})"
puts "Wejdź na: #{Rails.application.routes.url_helpers.login_url}, wpisz e-mail, potem podaj kod."
