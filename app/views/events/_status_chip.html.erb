<%# locals: (status:) -%>
<%# Plakietka „Główna lista / Rezerwa / Zaproszenie". Nieznany lub pusty status
    (np. user niezapisany na to zlecenie) nie renderuje niczego. %>
<% if (chip = participation_status_badge(status)) %>
  <span class="inline-flex items-center gap-0.5 rounded-full px-1.5 py-0.5 text-[10px] font-medium shrink-0 <%= chip[0] %>">
    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-2.5">
      <path d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"/>
    </svg>
    <%= chip[1] %>
  </span>
<% end %>
