<%# locals: (event:, offer:) -%>
<% driver = offer.user %>

<div class="mt-3 rounded-lg border px-3 py-2 text-sm <%= carpool_passenger_panel_classes(offer) %>">
  <% case carpool_passenger_state(offer) %>
  <% when :departed_for_me %>
    🚗 <span class="font-medium"><%= driver.display_name %></span> wyjechał — jedzie najpierw po Ciebie!
  <% when :departed_for_other %>
    🚗 <span class="font-medium"><%= driver.display_name %></span> jest w drodze — najpierw jedzie po: <span class="font-medium"><%= offer.first_pickup_user.display_name %></span>.
  <% when :departed %>
    🚗 <span class="font-medium"><%= driver.display_name %></span> jest w drodze.
  <% when :at_my_place %>
    🚗 <span class="font-medium"><%= driver.display_name %></span> czeka pod Twoim domem — wsiadaj.
  <% when :at_other_place %>
    🚗 <span class="font-medium"><%= driver.display_name %></span> jest teraz u: <span class="font-medium"><%= offer.current_pickup_user.display_name %></span>.
  <% end %>
</div>
