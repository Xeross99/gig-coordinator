<% participation = event.participations.active.find_by(user_id: Current.user&.id) %>
<% blocked = Current.user&.blocked_from?(event.host) %>

<%= turbo_stream_from event, :counts %>
<%= render "events/counts", event: event %>

<% if event.event_campaign_id? %>
  <%# Sub-event serii — zapis prowadzony jest na poziomie serii, ale pojedyncze
      zlecenie można opuścić indywidualnie (np. data nie pasuje), bez wypisywania
      się z całej serii. %>
  <div class="rounded-lg bg-amber-50 text-amber-900 px-3 py-3 text-sm mb-3">
    <div class="font-semibold mb-1">Zapis przez serię</div>
    <div class="text-xs text-amber-800 mb-2">
      Skład tego zlecenia pochodzi z serii „<%= event.event_campaign.name %>". Zapisz się raz na serię — pojawisz się we wszystkich nadchodzących zleceniach.
    </div>
    <%= link_to "Przejdź do serii", event_campaign_path(event.event_campaign),
                data: { turbo_frame: "_top" },
                class: "inline-flex items-center text-sm font-medium text-amber-900 underline" %>
  </div>
  <% if participation&.confirmed? %>
    <%= render "events/swap_requests", event: event %>
    <div class="rounded-lg bg-emerald-50 text-emerald-800 px-3 py-2 text-sm mb-3 animate-pop-in">Potwierdzony</div>
    <%= button_to "Wypisz mnie z tego zlecenia", event_participation_path(event), method: :delete,
                  data: { turbo_confirm: "Wypiszę Cię tylko z tego jednego terminu — w serii zostaniesz. Kontynuować?", haptic: "error", turbo_submits_with: "Wypisuję…" },
                  class: "w-full py-3 rounded-lg border border-stone-300 text-stone-800 font-medium transition-transform active:scale-[0.97] disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
  <% elsif participation&.waitlist? %>
    <%= render "events/swap_waiting", event: event %>
    <div class="rounded-lg bg-amber-50 text-amber-800 px-3 py-2 text-sm mb-3 animate-pop-in">Lista rezerwowa</div>
    <%= button_to "Wypisz mnie z tego zlecenia", event_participation_path(event), method: :delete,
                  data: { turbo_confirm: "Wypiszę Cię tylko z tego jednego terminu — w serii zostaniesz. Kontynuować?", haptic: "error", turbo_submits_with: "Wypisuję…" },
                  class: "w-full py-3 rounded-lg border border-stone-300 text-stone-800 font-medium transition-transform active:scale-[0.97] disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
  <% else %>
    <%# Powrót po „Wypisz mnie z tego zlecenia" — tylko dla aktywnego członka
        serii z anulowanym uczestnictwem w TYM zleceniu. Kto wypisał się
        z całej serii, wraca przez stronę serii (enroll_in_sub_events
        reaktywuje wtedy anulowane wiersze na sub-eventach). %>
    <% can_rejoin = !event.started? && !blocked && Current.user&.can_join_events? &&
                    event.participations.cancelled.exists?(user_id: Current.user.id) &&
                    event.event_campaign.campaign_participations.where(status: %i[confirmed waitlist]).exists?(user_id: Current.user.id) %>
    <% if can_rejoin %>
      <div class="rounded-lg bg-stone-100 text-stone-700 px-3 py-2 text-sm mb-3 animate-pop-in">Wypisałeś się z tego zlecenia — możesz wrócić.</div>
      <% if event.full? %>
        <%= button_to "Dołącz ponownie na listę rezerwową", event_participation_path(event), method: :post,
                      data: { haptic: "tap", turbo_submits_with: "Zapisuję na rezerwę…" },
                      class: "w-full py-3 rounded-lg bg-amber-500 text-white font-medium transition-transform active:scale-[0.97] hover:bg-amber-600 disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
      <% else %>
        <%= button_to "Dołącz ponownie do tego zlecenia", event_participation_path(event), method: :post,
                      data: { haptic: "confirm", turbo_submits_with: "Zapisuję…" },
                      class: "w-full py-3 rounded-lg bg-stone-900 text-white font-medium transition-transform active:scale-[0.97] hover:bg-stone-800 disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
      <% end %>
    <% end %>
  <% end %>
<% elsif event.started? %>
  <div class="rounded-lg bg-stone-100 text-stone-700 px-3 py-3 text-sm animate-pop-in flex items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="size-4 text-stone-500 shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
    </svg>
    <span class="font-medium">Zlecenie się rozpoczęło - zmiany niemożliwe.</span>
  </div>
<% elsif Current.user && !Current.user.can_join_events? && participation.nil? %>
  <div class="rounded-lg bg-amber-50 text-amber-900 px-3 py-2 text-sm mb-3 animate-pop-in">
    <div class="flex items-center gap-2">
      <span class="text-base leading-none" aria-hidden="true"><%= User::TITLE_ICONS["zoltodziob"] %></span>
      <span class="font-semibold">Tylko podgląd</span>
    </div>
    <div class="text-xs mt-1 text-amber-800">
      Jako Żółtodziób przeglądasz zlecenia, ale nie zapisujesz się na nie. Po awansie odzyskasz przycisk „Akceptuję”.
    </div>
  </div>
  <button type="button" disabled aria-disabled="true"
          class="w-full py-3 rounded-lg bg-stone-300 text-stone-500 font-medium cursor-not-allowed">
    Akceptuję
  </button>
<% elsif blocked && participation.nil? %>
  <div class="rounded-lg bg-red-50 text-red-800 px-3 py-2 text-sm mb-3 animate-pop-in">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="size-4 text-red-500 shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
      </svg>
      <span class="font-semibold">Blokada u gospodarza</span>
    </div>
    <div class="text-xs mt-1 text-red-700">
      Masz blokadę u tego gospodarza - nie możesz zapisać się na to zlecenie.
    </div>
  </div>
  <button type="button" disabled aria-disabled="true"
          class="w-full py-3 rounded-lg bg-stone-300 text-stone-500 font-medium cursor-not-allowed">
    Akceptuję
  </button>
<% elsif participation&.reserved? && !participation.reservation_expired? %>
  <% remaining_min = ((participation.reserved_until - Time.current) / 60).to_i %>
  <div class="rounded-lg bg-indigo-50 text-indigo-900 px-3 py-2 text-sm mb-3 animate-pop-in">
    <div class="flex items-center gap-2">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="size-4 text-indigo-500 animate-spin shrink-0">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="14 40"/>
      </svg>
      <span class="font-semibold">Masz rezerwację</span>
    </div>
    <div class="text-xs mt-1 text-indigo-700">
      Deadline: <%= l(participation.reserved_until, format: :short) %> (zostało ok. <%= [ remaining_min, 0 ].max %> min)
    </div>
  </div>
  <div class="grid grid-cols-2 gap-2">
    <%= button_to "Akceptuję", accept_event_participation_path(event), method: :post,
                  form: { class: "contents", data: { turbo_frame: "_top" } },
                  data: { haptic: "confirm", turbo_submits_with: "Akceptuję…" },
                  class: "w-full py-3 rounded-lg bg-stone-900 text-white font-medium transition-transform active:scale-[0.97] hover:bg-stone-800 disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
    <%= button_to "Odrzuć", decline_event_participation_path(event), method: :post,
                  form: { class: "contents", data: { turbo_frame: "_top" } },
                  data: { haptic: "error", turbo_submits_with: "Odrzucam…" },
                  class: "w-full py-3 rounded-lg border border-stone-300 text-stone-800 font-medium transition-transform active:scale-[0.97] disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
  </div>
<% elsif participation&.confirmed? %>
  <%= render "events/swap_requests", event: event %>
  <div class="rounded-lg bg-emerald-50 text-emerald-800 px-3 py-2 text-sm mb-3 animate-pop-in">Potwierdzony</div>
  <%= button_to "Anuluj", event_participation_path(event), method: :delete,
                data: { turbo_confirm: "Na pewno anulujesz udział w tym zleceniu?", haptic: "error", turbo_submits_with: "Anuluję…" },
                class: "w-full py-3 rounded-lg border border-stone-300 text-stone-800 font-medium transition-transform active:scale-[0.97] disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
<% elsif participation&.waitlist? %>
  <%= render "events/swap_waiting", event: event %>
  <div class="rounded-lg bg-amber-50 text-amber-800 px-3 py-2 text-sm mb-3 animate-pop-in">Lista rezerwowa</div>
  <%= button_to "Anuluj", event_participation_path(event), method: :delete,
                data: { turbo_confirm: "Na pewno zejdziesz z listy rezerwowej?", haptic: "error", turbo_submits_with: "Wypisuję…" },
                class: "w-full py-3 rounded-lg border border-stone-300 text-stone-800 font-medium transition-transform active:scale-[0.97] disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
<% elsif event.full? %>
  <%= button_to "Dołącz na listę rezerwową", event_participation_path(event), method: :post,
                data: { haptic: "tap", turbo_submits_with: "Zapisuję na rezerwę…" },
                class: "w-full py-3 rounded-lg bg-amber-500 text-white font-medium transition-transform active:scale-[0.97] hover:bg-amber-600 disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
<% else %>
  <%= button_to "Akceptuję", event_participation_path(event), method: :post,
                data: { haptic: "confirm", turbo_submits_with: "Zapisuję…" },
                class: "w-full py-3 rounded-lg bg-stone-900 text-white font-medium transition-transform active:scale-[0.97] hover:bg-stone-800 disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
<% end %>
