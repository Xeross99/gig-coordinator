<% content_for(:title) { "Edytuj zlecenie" } %>
<%= render "shared/breadcrumbs", crumbs: [
  [ @event.name, event_path(@event) ],
  [ "Edytuj zlecenie", nil ]
] %>

<h1 class="text-2xl font-semibold mb-4">Edytuj zlecenie</h1>

<%= render "form",
           event: @event,
           hosts: @hosts,
           url: event_path(@event),
           submit_label: "Zapisz zmiany",
           users_for_prereg: @users_for_prereg %>
