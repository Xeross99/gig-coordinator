<% content_for(:title) { Copy::Events::UPCOMING } %>
<%= render "shared/breadcrumbs", crumbs: [ [ Copy::Events::UPCOMING, nil ] ] %>
<div class="mb-4 flex items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold"><%= Copy::Events::UPCOMING %></h1>
  <% if Current.user&.event_creator_rank? %>
    <% if Current.user.can_create_events? %>
      <el-dropdown class="inline-block shrink-0">
        <button type="button"
                class="inline-flex items-center gap-1.5 rounded-md bg-stone-900 px-3 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-stone-800">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4">
            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" clip-rule="evenodd" fill-rule="evenodd"/>
          </svg>
          <%= Copy::Events::NEW_EVENT %>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="-mr-1 size-4 text-stone-300">
            <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
          </svg>
        </button>

        <el-menu anchor="bottom end" popover
                 class="w-64 origin-top-right rounded-md bg-white shadow-lg outline-1 outline-black/5
                        transition transition-discrete [--anchor-gap:--spacing(2)]
                        data-closed:scale-95 data-closed:transform data-closed:opacity-0
                        data-enter:duration-100 data-enter:ease-out
                        data-leave:duration-75 data-leave:ease-in">
          <div class="py-1">
            <%= link_to new_event_path,
                        class: "group/item flex items-start gap-3 px-4 py-3 text-sm text-stone-700 focus:bg-stone-100 focus:text-stone-900 focus:outline-hidden" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="mt-0.5 size-5 text-stone-400 group-focus/item:text-stone-500 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z" />
              </svg>
              <div class="min-w-0">
                <div class="font-medium text-stone-900">Pojedyncze zlecenie</div>
                <div class="text-xs text-stone-500 mt-0.5">Jedno wydarzenie z konkretną datą i składem.</div>
              </div>
            <% end %>
            <%= link_to new_event_campaign_path,
                        class: "group/item flex items-start gap-3 px-4 py-3 text-sm text-stone-700 focus:bg-stone-100 focus:text-stone-900 focus:outline-hidden" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="mt-0.5 size-5 text-amber-500 group-focus/item:text-amber-600 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="m7.875 14.25 1.214 1.942a2.25 2.25 0 0 0 1.908 1.058h2.006c.776 0 1.497-.4 1.908-1.058l1.214-1.942M2.41 9h4.636a2.25 2.25 0 0 1 1.872 1.002l.164.246a2.25 2.25 0 0 0 1.872 1.002h2.092a2.25 2.25 0 0 0 1.872-1.002l.164-.246A2.25 2.25 0 0 1 16.954 9h4.636M2.41 9a2.25 2.25 0 0 0-.16.832V12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 12V9.832c0-.287-.055-.57-.16-.832M2.41 9a2.25 2.25 0 0 1 .382-.632l3.285-3.832a2.25 2.25 0 0 1 1.708-.786h8.43c.657 0 1.281.287 1.709.786l3.284 3.832c.163.19.291.404.382.632M4.5 20.25h15A2.25 2.25 0 0 0 21.75 18v-2.625c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125V18a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
              <div class="min-w-0">
                <div class="font-medium text-stone-900">Seria zleceń</div>
                <div class="text-xs text-stone-500 mt-0.5">Wiele zleceń z głównym składem — zapisani idą na każde.</div>
              </div>
            <% end %>
          </div>
        </el-menu>
      </el-dropdown>
    <% else %>
      <span aria-disabled="true"
            title="<%= "Nie masz jeszcze przypisanego gospodarza." %>"
            class="inline-flex items-center gap-1.5 rounded-md bg-stone-300 px-3 py-1.5 text-sm font-semibold text-stone-500 shadow-xs cursor-not-allowed select-none">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4">
          <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" clip-rule="evenodd" fill-rule="evenodd"/>
        </svg>
        <%= Copy::Events::NEW_EVENT %>
      </span>
    <% end %>
  <% end %>
</div>

<div class="mb-4">
  <%= render "shared/sort_toggle",
             options: [["new", "Nadchodzące"], ["completed", "Wykonane"]],
             current: @filter,
             path_helper: :root_path,
             param_name: :filter,
             full_width: true %>
</div>

<%# :events and [Current.user, :events] streams are subscribed globally in
    the application layout so the `visit` action reaches workers on any page. %>

<div class="sort-target">
  <%# Wspólna lista: serie i pojedyncze zlecenia mieszane chronologicznie po
      scheduled_at (dla kampanii: najbliższy upcoming sub-event w trybie „new",
      ostatni miniony w „completed"). Sub-eventy (Event z event_campaign_id)
      świadomie nie trafiają do tej listy — dostępne ze strony serii.
      Broadcasty (`broadcast_prepend_to`) lecą na #events_list — świeże karty
      lądują na górze niezależnie od czasu, do refreshu. %>
  <ul id="events_list" class="space-y-3">
    <% @feed.each do |row| %>
      <% if row[:kind] == :campaign %>
        <%= render "event_campaigns/event_campaign_card",
                   campaign: row[:item],
                   pending_reservation: @pending_campaign_ids.include?(row[:item].id),
                   campaign_upcoming_events: @campaign_upcoming_events[row[:item].id] || [],
                   campaign_slots_taken: @campaign_slots_taken[row[:item].id] || 0,
                   my_sub_event_status: @my_sub_event_statuses %>
      <% else %>
        <%= render "event_card",
                   event: row[:item],
                   pending_reservation: @pending_event_ids.include?(row[:item].id),
                   my_status: @my_status_by_event_id[row[:item].id] %>
      <% end %>
    <% end %>
  </ul>

  <div id="events_empty" class="<%= "hidden" unless @feed.empty? %> text-stone-500 py-8 text-center">
    <% if @filter == "completed" %>
      Brak wykonanych zleceń.
    <% else %>
      <%= image_tag "znudzona_kura.svg", alt: "", "aria-hidden": true, class: "mx-auto mb-3 w-48 max-w-full" %>
      Brak nadchodzących zleceń.
    <% end %>
  </div>
</div>
