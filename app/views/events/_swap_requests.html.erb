<%# Przychodzące propozycje wymiany (Current.user = target, confirmed). Locals: event: %>
<% unless event.started? %>
  <% pending_swaps = event.swap_proposals.pending.where(target_id: Current.user.id).where("expires_at > ?", Time.current).includes(:proposer) %>
  <% pending_swaps.each do |sp| %>
    <div class="rounded-lg bg-indigo-50 text-indigo-900 px-3 py-2 text-sm mb-3 animate-pop-in">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-4 text-indigo-500 shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
        </svg>
        <span class="font-semibold"><%= sp.proposer.display_name %> <%= "chce się z Tobą zamienić" %></span>
      </div>
      <div class="grid grid-cols-2 gap-2 mt-2">
        <%= button_to "Akceptuj wymianę", accept_event_swap_proposal_path(event, sp), method: :post,
                      form: { class: "contents", data: { turbo_frame: "_top" } },
                      data: { haptic: "confirm", turbo_submits_with: "Akceptuje..." },
                      class: "w-full py-2 rounded-lg bg-stone-900 text-white text-sm font-medium transition-transform active:scale-[0.97]" %>
        <%= button_to "Odrzuć", decline_event_swap_proposal_path(event, sp), method: :post,
                      form: { class: "contents", data: { turbo_frame: "_top" } },
                      data: { haptic: "error", turbo_submits_with: "Odrzucam..." },
                      class: "w-full py-2 rounded-lg border border-stone-300 text-stone-800 text-sm font-medium transition-transform active:scale-[0.97]" %>
      </div>
    </div>
  <% end %>
<% end %>
