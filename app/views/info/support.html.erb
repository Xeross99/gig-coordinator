<% content_for(:title) { "Wesprzyj aplikację" } %>
<%= render "shared/breadcrumbs", crumbs: [ [ "Wesprzyj aplikację", nil ] ] %>

<h1 class="text-2xl font-semibold mb-4">Wesprzyj aplikację</h1>

<%# Cennik premium — kompaktowa wersja klasycznej sekcji pricingowej.
    Jedyny benefit wsparcia: karta pracownika (animowane tło paska rosteru). %>
<div class="bg-white rounded-2xl shadow-sm ring-1 ring-stone-200 overflow-hidden mb-4">
  <div class="p-4 sm:p-5">
    <h2 class="text-base font-semibold tracking-tight text-stone-900 flex items-center gap-2">
      Karta pracownika
      <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-700">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-3">
          <path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"/>
        </svg>
        <%= Copy::Users::PREMIUM_BADGE %>
      </span>
    </h2>
    <p class="mt-1 text-sm text-stone-600">Aplikacja jest darmowa i bez reklam. Jeśli dorzucisz się do jej utrzymania, w podzięce odblokujesz karty pracownika — animowane, pixel-artowe tła, które widzi każdy na Twoim pasku.</p>
    <div class="mt-4 flex items-center gap-x-3">
      <h3 class="flex-none text-xs font-semibold text-amber-700">Co dostajesz w podzięce</h3>
      <div class="h-px flex-auto bg-stone-100"></div>
    </div>
    <ul role="list" class="mt-3 space-y-2 text-sm text-stone-600">
      <% [ "#{User::PLAYER_CARDS.size} animowanych kart do wyboru — traktor, ładowarka, kosmos i inne",
           "Twoje tło widoczne w widoku każdego zlecenia, na profilu i przy podwózkach",
           "Nowe karty w przyszłości bez dopłat" ].each do |perk| %>
        <li class="flex gap-x-2.5">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 flex-none text-amber-600">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
          </svg>
          <%= perk %>
        </li>
      <% end %>
    </ul>
  </div>
  <div class="bg-stone-50 border-t border-stone-100 py-5 px-4 text-center">
    <p class="text-xs font-semibold text-stone-600">Wsparcie na rok</p>
    <p class="mt-2 flex items-baseline justify-center gap-x-1.5">
      <span class="text-4xl font-semibold tracking-tight text-stone-900">29,99 zł</span>
      <span class="text-sm font-semibold tracking-wide text-stone-600">/ rok</span>
    </p>
    <p class="mt-2 text-xs text-stone-500">Zgłoś się do administratora — po wsparciu karty odblokują się na Twoim koncie.</p>
  </div>
</div>

<% if Current.user.premium? %>
  <div class="bg-amber-50 rounded-xl p-4 mb-4 text-sm text-amber-800">
    <p class="font-medium">Dzięki za wsparcie!
      <% if Current.user.premium_active? %>
        Aktywne do <%= l(Current.user.premium_until.to_date, format: :long) %>.
      <% end %>
    </p>
    <p class="mt-1">
      Swoją kartę wybierzesz w
      <%= link_to "Moim profilu", edit_profile_path, class: "font-semibold underline" %>.
    </p>
  </div>
<% end %>

<%# Zajawka: wszystkie karty widoczne; kłódka tylko gdy konto nie ma premium. %>
<div class="bg-white rounded-xl shadow-sm p-5">
  <h2 class="font-medium mb-3">Dostępne karty</h2>
  <div class="space-y-3" aria-hidden="true">
    <% User::PLAYER_CARDS.each do |card| %>
      <div>
        <div class="relative rounded-lg overflow-hidden ring-1 ring-stone-200">
          <%= image_tag "player_cards/#{card}.svg", alt: "",
                        class: "w-full aspect-[6/1] #{"grayscale-[50%] opacity-70" unless Current.user.premium?}" %>
          <% unless Current.user.premium? %>
            <span class="absolute top-2 right-2 flex items-center justify-center size-6 rounded-full bg-white/85 shadow-sm">
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-3.5 text-stone-500">
                <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/>
              </svg>
            </span>
          <% end %>
        </div>
        <span class="mt-1.5 block text-center text-xs text-stone-500"><%= User::PLAYER_CARD_LABELS.fetch(card) %></span>
      </div>
    <% end %>
  </div>
</div>
