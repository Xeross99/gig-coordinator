<% content_for(:title) { "Serie zleceń" } %>
<div class="flex items-center justify-between mb-5">
  <h1 class="text-2xl font-semibold">Serie zleceń</h1>
  <%= link_to "Nowa seria", new_host_event_campaign_path,
              class: "px-4 py-2 bg-stone-900 text-white rounded-lg text-sm font-medium" %>
</div>

<% if @campaigns.any? %>
  <ul class="space-y-3">
    <% @campaigns.each do |campaign| %>
      <% events_count = @event_counts[campaign.id] || 0 %>
      <li class="bg-white rounded-xl shadow-sm p-4">
        <%= link_to host_event_campaign_path(campaign), class: "block" do %>
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="font-medium text-stone-900"><%= campaign.name %></div>
              <div class="text-sm text-stone-500 mt-0.5">
                Stały skład: <%= @slots_taken[campaign.id] || 0 %>/<%= campaign.capacity %>
              </div>
            </div>
            <div class="text-right">
              <div class="font-medium text-stone-900 tabular-nums"><%= events_count %></div>
              <div class="text-xs text-stone-500 mt-0.5"><%= jobs_label(events_count) %></div>
            </div>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="text-stone-500 py-8 text-center">Brak serii zleceń.</div>
<% end %>
