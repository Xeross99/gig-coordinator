<%= form_with model: [:host, campaign], local: true, class: "space-y-4" do |f| %>
  <% if campaign.errors.any? %>
    <div class="bg-red-50 text-red-800 rounded-lg p-3 text-sm">
      <ul class="list-disc list-inside">
        <% campaign.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nazwa serii", class: "block text-sm text-stone-700 mb-1" %>
    <%= f.text_field :name, required: true, class: "w-full px-3 py-3 rounded-lg border border-stone-300 bg-white" %>
  </div>

  <div>
    <%= f.label :capacity, "Liczba miejsc w głównym składzie", class: "block text-sm text-stone-700 mb-1" %>
    <%= f.select :capacity, (1..20).to_a, {},
                 required: true,
                 class: "form-select w-full px-3 py-3 rounded-lg border border-stone-300 bg-white" %>
    <p class="text-xs text-stone-500 mt-1">Ile osób ma być w głównym składzie serii. Mistrze Pióra dostaną automatyczne rezerwacje aż skład się zapełni.</p>
  </div>

  <%= f.submit data: { turbo_submits_with: "Zapisuję…" },
              class: "w-full py-3 rounded-lg bg-stone-900 text-white font-medium disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
<% end %>
