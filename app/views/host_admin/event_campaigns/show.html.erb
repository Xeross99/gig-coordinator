<% content_for(:title) { @campaign.name } %>
<%= render "shared/breadcrumbs", crumbs: [
  [ Copy::EventCampaigns::INDEX_TITLE, host_event_campaigns_path ],
  [ @campaign.name, nil ]
], home_path: host_root_path %>

<div class="bg-white rounded-xl shadow-sm p-5">
  <h1 class="text-2xl font-semibold text-stone-900"><%= @campaign.name %></h1>
  <div class="mt-1 text-sm text-stone-500">
    <% events_count = @campaign.events.count %>
    Stały skład: <%= @campaign.capacity %>; <%= events_count %> <%= jobs_label(events_count) %>
  </div>

  <div class="grid grid-cols-2 gap-2 mt-5">
    <%= link_to "Edytuj", edit_host_event_campaign_path(@campaign),
                class: "text-center py-2 rounded-lg border border-stone-300 text-sm font-medium text-stone-800 hover:bg-stone-50" %>
    <%= button_to "Usuń", host_event_campaign_path(@campaign), method: :delete,
                  data: { turbo_confirm: "Na pewno? Usunie wszystkie zlecenia w serii." },
                  form: { class: "contents" },
                  class: "w-full py-2 rounded-lg bg-red-50 text-red-700 text-sm font-medium hover:bg-red-100" %>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm p-5 mt-4">
  <h2 class="text-lg font-semibold mb-3"><%= Copy::EventCampaigns::SUB_EVENTS_HEADING %></h2>
  <% if @upcoming_sub_events.any? || @past_sub_events.any? %>
    <ul class="space-y-3">
      <% (@upcoming_sub_events + @past_sub_events).each do |event| %>
        <li class="bg-stone-50 rounded-lg p-3">
          <%= link_to host_event_path(event), class: "block" do %>
            <div class="font-medium text-stone-900"><%= event.name %></div>
            <div class="text-sm text-stone-500 mt-0.5"><%= l(event.scheduled_at, format: :long) %></div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="text-stone-400 text-sm">Brak zleceń w serii.</div>
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm p-5 mt-4">
  <h2 class="text-lg font-semibold mb-4">Primary roster</h2>
  <%= turbo_stream_from @campaign, :roster %>
  <%= render "event_campaigns/roster", campaign: @campaign %>
</div>

<details class="bg-white rounded-xl shadow-sm mt-4 group">
  <summary class="cursor-pointer list-none p-5 flex items-center justify-between">
    <h2 class="text-lg font-semibold"><%= Copy::HostPanel::History::HEADING %> (<%= @history.size %>)</h2>
  </summary>
  <% if @history.any? %>
    <ul class="px-5 pb-5 space-y-2">
      <% @history.each do |e| %>
        <li class="flex items-center gap-3 text-sm text-stone-700">
          <time class="text-xs text-stone-500 tabular-nums shrink-0 w-28"><%= l(e.created_at, format: :short) %></time>
          <span class="font-medium text-stone-900 truncate"><%= e.campaign_participation.user.display_name %></span>
          <span class="text-stone-500 truncate"><%= host_history_verb(e.event_type) %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="px-5 pb-5 text-sm text-stone-400"><%= Copy::HostPanel::History::EMPTY %></p>
  <% end %>
</details>
