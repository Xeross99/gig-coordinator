<% content_for(:title) { "Statystyki" } %>
<%= render "shared/breadcrumbs", crumbs: [ [ "Statystyki", nil ] ] %>

<div class="mb-4">
  <h1 class="text-2xl font-semibold">Statystyki</h1>
  <p class="text-sm text-stone-500 mt-1">Trofea, które wręczamy automatycznie. Bez ceremonii.</p>
</div>

<ul class="space-y-3">
  <% @trophies.each do |t| %>
    <li class="rounded-xl bg-white shadow-sm overflow-hidden">
      <div class="p-4 border-b border-stone-100">
        <div class="flex items-start gap-3">
          <span aria-hidden="true" class="text-3xl leading-none shrink-0"><%= t[:emoji] %></span>
          <div class="min-w-0">
            <div class="font-semibold text-stone-900"><%= t[:title] %></div>
            <p class="text-xs text-stone-500 mt-1"><%= t[:description] %></p>
          </div>
        </div>
      </div>
      <div class="p-4 bg-stone-50">
        <% if t[:winner] %>
          <%= link_to user_path(t[:winner]),
                      class: "flex items-center gap-4 group" do %>
            <% if t[:winner].photo.attached? %>
              <%= image_tag rails_representation_path(t[:winner].photo.variant(:small)),
                            alt: t[:winner].display_name,
                            class: "size-16 rounded-full object-cover ring-2 ring-amber-200 shrink-0" %>
            <% else %>
              <div class="size-16 rounded-full bg-stone-200 flex items-center justify-center text-stone-600 text-base font-semibold ring-2 ring-amber-200 shrink-0"
                   aria-hidden="true">
                <%= t[:winner].first_name[0] %><%= t[:winner].last_name[0] %>
              </div>
            <% end %>
            <div class="min-w-0 flex-1">
              <div class="font-medium text-stone-900 truncate group-hover:underline">
                <%= t[:winner].display_name %>
              </div>
              <div class="mt-1"><%= render "users/title_badge", user: t[:winner] %></div>
            </div>
            <% if t[:value].present? && t[:value] != 0 %>
              <% short_unit = t[:unit].is_a?(String) && t[:unit].length <= 3 %>
              <div class="text-right shrink-0">
                <div class="text-2xl font-bold tabular-nums text-stone-900 leading-none">
                  <%= t[:value] %><% if short_unit %><span class="text-base font-medium text-stone-500"><%= t[:unit] %></span><% end %>
                </div>
                <% if t[:unit] && !short_unit %>
                  <div class="text-[11px] text-stone-500 mt-1"><%= t[:unit] %></div>
                <% end %>
              </div>
            <% end %>
          <% end %>
          <% if t[:runners_up].any? %>
            <% short_unit = t[:unit].is_a?(String) && t[:unit].length <= 3 %>
            <ul class="mt-3 pt-3 border-t border-stone-200/70 space-y-2">
              <% t[:runners_up].each_with_index do |entry, i| %>
                <li>
                  <%= link_to user_path(entry[:user]), class: "flex items-center gap-2.5 group" do %>
                    <span class="w-4 text-center text-[11px] font-semibold text-stone-400 shrink-0"><%= i + 2 %>.</span>
                    <% if entry[:user].photo.attached? %>
                      <%= image_tag rails_representation_path(entry[:user].photo.variant(:small)),
                                    alt: entry[:user].display_name,
                                    class: "size-8 rounded-full object-cover shrink-0" %>
                    <% else %>
                      <div class="size-8 rounded-full bg-stone-200 flex items-center justify-center text-stone-600 text-[10px] font-semibold shrink-0"
                           aria-hidden="true">
                        <%= entry[:user].first_name[0] %><%= entry[:user].last_name[0] %>
                      </div>
                    <% end %>
                    <span class="min-w-0 flex-1 truncate text-sm text-stone-700 group-hover:underline"><%= entry[:user].display_name %></span>
                    <% if entry[:value].present? && entry[:value] != 0 %>
                      <span class="text-sm font-semibold tabular-nums text-stone-500 shrink-0">
                        <%= entry[:value] %><% if short_unit %><span class="text-xs font-medium text-stone-400"><%= t[:unit] %></span><% end %>
                      </span>
                    <% end %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% else %>
          <div class="text-sm text-stone-400 italic text-center py-2">Brak zwycięzcy — czekamy na pretendenta.</div>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
