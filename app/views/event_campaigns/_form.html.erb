<%# Locals: campaign:, hosts:, url:, submit_label:, users_for_prereg: (optional). %>
<%= form_with model: campaign, url: url, local: true, class: "space-y-4",
              data: { controller: "nested-events" } do |f| %>
  <% if campaign.errors.any? %>
    <div class="bg-red-50 text-red-800 rounded-lg p-3 text-sm">
      <ul class="list-disc list-inside">
        <% campaign.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :host_id, Copy::Events::HOST_LABEL, class: "block text-sm text-stone-700 mb-1" %>
    <%= f.collection_select :host_id, hosts, :id, :display_name,
                            { include_blank: "— wybierz gospodarza —" },
                            { required: true,
                              class: "form-select w-full px-3 py-3 rounded-lg border border-stone-300 bg-white" } %>
  </div>

  <div>
    <%= f.label :name, Copy::EventCampaigns::NAME_LABEL, class: "block text-sm text-stone-700 mb-1" %>
    <%= f.text_field :name, required: true,
                     placeholder: "Np. „Pieczka — 4 terminy\"",
                     class: "w-full px-3 py-3 rounded-lg border border-stone-300 bg-white" %>
  </div>

  <div>
    <%= f.label :capacity, Copy::EventCampaigns::CAPACITY_LABEL, class: "block text-sm text-stone-700 mb-1" %>
    <%= f.select :capacity, (1..20).to_a, {},
                 required: true,
                 class: "form-select w-full px-3 py-3 rounded-lg border border-stone-300 bg-white" %>
    <p class="text-xs text-stone-500 mt-1"><%= Copy::EventCampaigns::CAPACITY_HINT %></p>
  </div>

  <div>
    <%= f.label :notes, "Notatka", class: "block text-sm text-stone-700 mb-1" %>
    <%= f.text_area :notes, rows: 3, placeholder: "Opcjonalna notatka dla kurołapaczy...",
                    class: "w-full px-3 py-3 rounded-lg border border-stone-300 bg-white resize-none" %>
  </div>

  <% if users_for_prereg.present? && users_for_prereg.any? %>
    <div>
      <label class="block text-sm text-stone-700 mb-1"><%= "Zapisz od razu" %></label>
      <p class="text-xs text-stone-500 mb-2"><%= "Zaznaczone osoby zostaną od razu zapisane do głównego składu. Mistrze Pióra nie pojawiają się tutaj - dostają automatyczną rezerwację." %></p>
      <div class="border border-stone-300 rounded-lg bg-white max-h-64 overflow-y-auto">
        <%= f.collection_check_boxes :pre_registered_user_ids, users_for_prereg, :id, :display_name do |b| %>
          <label class="flex items-center gap-3 px-3 py-2 cursor-pointer hover:bg-stone-50 border-b border-stone-100 last:border-b-0">
            <%= b.check_box class: "size-4 rounded border-stone-300 text-stone-900 focus:ring-stone-900" %>
            <%= render "events/roster_avatar", user: b.object %>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-stone-900 truncate"><%= b.object.display_name %></div>
              <div class="mt-0.5"><%= render "users/title_badge", user: b.object %></div>
            </div>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="border-t border-stone-200 pt-4">
    <h2 class="text-sm font-semibold text-stone-700 mb-3"><%= Copy::EventCampaigns::SUB_EVENTS_HEADING %></h2>

    <%# Template dla nowego wiersza — Stimulus klonuje go po kliknięciu „Dodaj". %>
    <template data-nested-events-target="template">
      <%= f.fields_for :events, Event.new, child_index: "NEW_RECORD" do |sub_f| %>
        <%= render "sub_event_fields", f: sub_f %>
      <% end %>
    </template>

    <div data-nested-events-target="container" class="space-y-3">
      <%= f.fields_for :events do |sub_f| %>
        <%= render "sub_event_fields", f: sub_f %>
      <% end %>
    </div>

    <button type="button"
            data-action="nested-events#add"
            class="mt-3 w-full py-2 rounded-lg border border-dashed border-stone-400 text-sm font-medium text-stone-700 hover:bg-stone-50">
      + <%= "Dodaj zlecenie do serii" %>
    </button>
  </div>

  <%= f.submit submit_label, data: { turbo_submits_with: "Zapisuję…" },
              class: "w-full py-3 rounded-lg bg-stone-900 text-white font-medium disabled:opacity-60 disabled:cursor-progress disabled:animate-turbo-loading" %>
<% end %>
