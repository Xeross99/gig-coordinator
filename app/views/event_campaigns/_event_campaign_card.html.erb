<%# locals: (event_campaign:, pending_reservation: false, campaign_upcoming_events: nil,
             campaign_slots_taken: nil, my_sub_event_status: nil) -%>
<%# Karta serii zleceń. Trzy ostatnie locale są opcjonalne: feed batchuje je
    w kontrolerze, a broadcast renderuje kartę bez nich i wtedy `campaign_card`
    dolicza brakujące kawałki sam. %>
<% card = campaign_card(event_campaign, upcoming: campaign_upcoming_events,
                        statuses: my_sub_event_status, slots_taken: campaign_slots_taken) %>
<li id="<%= dom_id(event_campaign) %>"
    class="rounded-xl shadow-sm overflow-hidden relative <%= event_campaign.completed? ? 'bg-stone-100' : 'bg-gradient-to-br from-amber-50 via-white to-white ring-1 ring-amber-100' %> <%= 'ring-2 ring-indigo-400' if pending_reservation %>">
  <% if pending_reservation %>
    <span aria-hidden="true" class="absolute top-2 right-2 z-10 flex size-3">
      <span class="absolute inline-flex size-full rounded-full bg-indigo-400 opacity-75 animate-ping"></span>
      <span class="relative inline-flex size-3 rounded-full bg-indigo-500"></span>
    </span>
  <% end %>
  <%= link_to event_campaign_path(event_campaign), class: "block p-4" do %>
    <div class="min-w-0">
      <div class="flex items-center flex-wrap gap-x-2 gap-y-1">
        <span class="font-medium text-stone-900 truncate"><%= event_campaign.name %></span>
      </div>
      <div class="flex items-center gap-1.5 text-xs text-stone-500 mt-1">
        <%= render "shared/host_avatar", host: event_campaign.host %>
        <span class="truncate">Gospodarz: <%= event_campaign.host.display_name %></span>
        <%= render "hosts/supporter_badge", host: event_campaign.host %>
      </div>
      <div class="flex items-center gap-3 text-xs text-stone-500 mt-1">
        <span>Stały skład: <%= card.slots_taken %>/<%= event_campaign.capacity %></span>
      </div>
      <% if pending_reservation %>
        <div class="text-xs text-indigo-600 mt-1 font-medium">Rezerwacja oczekuje na Twoje potwierdzenie</div>
      <% end %>
    </div>

    <div class="mt-3 rounded-lg bg-white/70 ring-1 ring-amber-100 px-3 py-2">
      <% if card.preview.any? %>
        <ul class="space-y-1">
          <% card.preview.each do |sub_event| %>
            <li class="flex items-center gap-2 min-w-0">
              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-700 shrink-0 tabular-nums"><%= relative_time_chip(sub_event.scheduled_at) %></span>
              <span class="text-xs text-stone-800 truncate min-w-0 flex-1"><%= sub_event.name %></span>
              <%= render "events/status_chip", status: card.statuses[sub_event.id] %>
            </li>
          <% end %>
          <% if card.extra_count.positive? %>
            <li class="text-[11px] text-stone-400">+<%= card.extra_count %> więcej</li>
          <% end %>
        </ul>
      <% else %>
        <div class="text-xs text-stone-400">Brak nadchodzących zleceń</div>
      <% end %>
    </div>
  <% end %>
</li>
